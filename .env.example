# Copy this file to .env.local and fill in real values.
# IMPORTANT: never commit .env.local (or any .env* except this example).

# ---- Database (PostgreSQL) ----
# Default matches the Docker Compose dev database (mise run dev / npm run dev:local).
DATABASE_URL=postgresql://optiqa:optiqa@localhost:5432/optiqa
# Optional: only needed for the prod data-sync scripts in scripts/
# PRODUCTION_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ---- AWS S3 (server-side only — NEVER prefixed NEXT_PUBLIC_) ----
# These are read only by server code (src/lib/s3.ts) and are never sent to the browser.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-bucket-name

# ---- NextAuth ----
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- Optional flags ----
# LOG_LEVEL=debug                 # debug | info | warn | error (default: info in prod, debug otherwise)
# NEXT_PUBLIC_MIN_COMPARISONS=10  # min comparisons before ratings are considered meaningful
# NEXT_PUBLIC_DISABLE_AUTH=true   # DEV ONLY: bypass auth entirely. Never set in production.

# ---- Optional: Vercel KV (only if you use the KV-backed features) ----
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
